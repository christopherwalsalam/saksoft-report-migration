{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ReportConversionDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_STRONG_SECRET_KEY_MIN_32_CHARACTERS",
    "Issuer": "ReportConversion.API",
    "Audience": "ReportConversion.Clients",
    "ExpiryMinutes": 480
  },
  "SapBo": {
    "BaseUrl": "http://your-sap-bo-server:8080",
    "Username": "your-username",
    "Password": "your-password",
    "AuthType": "secEnterprise",
    "BatchSize": 100,
    "RetryCount": 3,
    "RetryDelaySeconds": 2
  },
  "AzureOpenAi": {
    "Endpoint": "https://your-openai.openai.azure.com/",
    "ApiKey": "your-azure-openai-api-key",
    "ChatDeploymentName": "gpt-4o",
    "EmbeddingDeploymentName": "text-embedding-3-large",
    "ApiVersion": "2024-02-01"
  },
  "AzureBlob": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net",
    "ContainerName": "powerbi-reports"
  },
  "PowerBi": {
    "TenantId": "your-tenant-id",
    "ClientId": "your-client-id",
    "ClientSecret": "your-client-secret",
    "WorkspaceId": "your-workspace-id",
    "OutputDirectory": "output/pbix"
  },
  "StaleReport": {
    "StaleDaysThreshold": 180
  },
  "DuplicateDetection": {
    "SimilarityThreshold": 0.92
  },
  "Migration": {
    "OutputDirectory": "output/pbix",
    "UploadToBlob": true
  },
  "Hangfire": {
    "SqlServerConnectionString": "Server=localhost;Database=ReportConversionHangfire;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=localhost;Database=ReportConversionDB;Trusted_Connection=True;TrustServerCertificate=True;",
          "sinkOptionsSection": {
            "tableName": "AppLogs",
            "autoCreateSqlTable": true
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
